# ─────────────────────────────────────────────────
# Portfolio Backend — Environment Variables
# Copy this file to .env and fill in your values
# ─────────────────────────────────────────────────

# Server
PORT=3000

# Email service: "gmail" (recommended) or leave blank for generic SMTP
EMAIL_SERVICE=gmail

# Your Gmail address used to SEND emails
EMAIL_USER=debashissahoo2004@gmail.com

# Gmail App Password (NOT your Gmail login password!)
# How to get one: Google Account → Security → 2-Step Verification → App Passwords
# Generate a new app password for "Mail" + "Other (Portfolio)"
EMAIL_PASS=your_16_char_app_password_here

# Where contact notifications are sent (defaults to EMAIL_USER if not set)
OWNER_EMAIL=debashissahoo2004@gmail.com

# Optional: restrict CORS to your domain in production
# ALLOWED_ORIGIN=https://debasishsahoo.dev

# ── Generic SMTP (alternative to Gmail) ──────────
# SMTP_HOST=smtp.yourprovider.com
# SMTP_PORT=587
# SMTP_SECURE=false
